+static PyObject *PyModel_SetDrawableOpacityOverrides(PyModelObject *self, PyObject *args)
+{
+    PyObject* mapping;
+    if (!PyArg_ParseTuple(args, "O!", &PyDict_Type, &mapping)) return nullptr;
+    const int count = self->model->GetDrawableCount();
+    std::vector<float> values(count, 1.0f);
+    PyObject *key, *value;
+    Py_ssize_t position = 0;
+    while (PyDict_Next(mapping, &position, &key, &value))
+    {
+        const long index = PyLong_AsLong(key);
+        if (PyErr_Occurred()) return nullptr;
+        const double opacity = PyFloat_AsDouble(value);
+        if (PyErr_Occurred()) return nullptr;
+        if (index < 0 || index >= count || !std::isfinite(opacity) || opacity < 0.0 || opacity > 1.0)
+        {
+            PyErr_SetString(PyExc_ValueError, "drawable index/opacity out of range");
+            return nullptr;
+        }
+        values[index] = static_cast<float>(opacity);
+    }
+    self->model->SetDrawableOpacityOverrides(values);
+    Py_RETURN_NONE;
+}
+
+static PyObject *PyModel_GetDrawableOpacityMultiplier(PyModelObject *self, PyObject *args)
+{
+    int index;
+    if (!PyArg_ParseTuple(args, "i", &index)) return nullptr;
+    if (index < 0 || index >= self->model->GetDrawableCount())
+    {
+        PyErr_SetString(PyExc_ValueError, "drawable index out of range");
+        return nullptr;
+    }
+    return PyFloat_FromDouble(self->model->GetDrawableOpacityMultiplier(index));
+}
+
+static PyObject *PyModel_GetIntrinsicDrawableOpacity(PyModelObject *self, PyObject *args)
+{
+    int index;
+    if (!PyArg_ParseTuple(args, "i", &index)) return nullptr;
+    if (index < 0 || index >= self->model->GetDrawableCount())
+    {
+        PyErr_SetString(PyExc_ValueError, "drawable index out of range");
+        return nullptr;
+    }
+    return PyFloat_FromDouble(self->model->GetIntrinsicDrawableOpacity(index));
+}
